# https://rosepinetheme.com/palette/ingredients/

set -g pane-border-style fg="#6e6a86"
set -g pane-active-border-style fg="#ebbcba"

set -g status-bg "#26233a" # Rosé Pine Overlay
set -g status-fg "#908caa" # Rosé Pine Subtle
set-window-option -g window-status-current-style fg="#e0def4" # Rosé Pine Text

set -g popup-border-style 'fg=#ea9a97'
set -g popup-border-line rounded
