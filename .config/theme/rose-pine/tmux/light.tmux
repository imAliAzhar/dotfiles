# https://rosepinetheme.com/palette/ingredients/

set -g pane-border-style fg="#6e6a86"
set -g pane-active-border-style fg="#ebbcba"

set -g status-bg "#f2e9e1" # Rosé Pine Dawn Overlay
set -g status-fg "#797593" # Rosé Pine Dawn Subtle
set-window-option -g window-status-current-style fg="#d7827e" # Rosé Pine Dawn Rose
set -g popup-border-style "fg=#ebbcba"

set -g popup-border-style 'fg=#ea9a97'
set -g popup-border-line rounded
