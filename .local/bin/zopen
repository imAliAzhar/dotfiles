#!/bin/zsh

# Extend lf's open command to append dirs to zoxide


if [[ -d $fx ]]; then
    zoxide add $fx
fi

read index window <<< $(tmux list-windows -F '#I #W' | head -n 1)

if [[ -d $fx || $index -ne 1 || ($window != "hx" && $window != "nvim") ]]; then
  lf -remote  "send $id open \"$fx\""
  exit 0
fi

if [[ $window = "hx" ]]; then
    tmux send-keys -t 1.1 ":open '$fx'" Enter
elif [[ $window = "nvim" ]]; then
    tmux send-keys -t 1.1 ":edit $fx" Enter
fi

tmux select-window -t 1 \; select-pane -t 1;

if [[ -n "$TMUX" && -z "$TMUX_PANE" ]]; then
  TMUX_POPUP=true
fi

if [[ -n $TMUX_POPUP ]]; then
  lf -remote  "send $id quit"
fi

