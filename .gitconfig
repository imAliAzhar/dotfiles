[blame]
  date = human
[merge]
  conflictstyle = diff3
[pull]
	rebase = true
[push]
  autoSetupRemote = true
[core]
  pager = delta
  mergeoptions = --no-edit
	excludesfile = /Users/aliazhar.khan/.config/git/gitignore
[credential]
	helper = store
[user]
	name = imAliAzhar
	email = aliazhkh@gmail.com
[interactive]
    diffFilter = delta --color-only
    singlekey = true
[delta]
    navigate = true    # use n and N to move between diff sections
    light = false      # set to true if you're in a terminal w/ a light background color (e.g. the default macOS terminal)
	side-by-side = false
	features = lemonade

[diff]
    external = difft
    colorMoved = default

[difft]
	display=side-by-side

[include]
    path = ~/.config/delta/themes.gitconfig
